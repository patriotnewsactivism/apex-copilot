{
  "name": "apex-copilot",
  "version": "1.0.0",
  "description": "Pure Apex Copilot contract: flags, action registry, deny list, audit shapes, and deferred v1 gates. The dashboard stays in patriotnewsactivism/Apex.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client-entry.d.ts",
      "import": "./dist/client-entry.js",
      "default": "./dist/client-entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
